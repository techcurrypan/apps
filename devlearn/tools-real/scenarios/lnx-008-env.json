{
	"id": "lnx-008-env",
	"tool": "shell",
	"lesson": "lnx-008",
	"note": "変数と export、PATH の前から探す、PATH に足す",
	"steps": [
		"echo $HOME",
		"echo $USER",
		"echo $PATH",
		"NAME=devlearn",
		"echo $NAME",
		"bash -c 'echo \"[$NAME]\"'",
		"export NAME",
		"bash -c 'echo \"[$NAME]\"'",
		"export GREETING=hello",
		"env | grep GREETING",
		"env | grep NAME",
		"which ls",
		"which git",
		"which nosuch",
		"which nosuch; echo $?",
		"mkdir -p ~/bin",
		"printf '#!/bin/bash\\necho \"my tool\"\\n' > ~/bin/mytool",
		"chmod +x ~/bin/mytool",
		"mytool",
		"~/bin/mytool",
		"export PATH=\"$HOME/bin:$PATH\"",
		"echo $PATH",
		"which mytool",
		"mytool",
		"printf '#!/bin/bash\\necho \"my ls\"\\n' > ~/bin/ls",
		"chmod +x ~/bin/ls",
		"ls",
		"which ls",
		"which -a ls",
		"/usr/bin/ls",
		"rm ~/bin/ls",
		"ls",
		"echo \"[$NOPE]\"",
		"unset NAME",
		"echo \"[$NAME]\"",
		"NAME = x",
		"export X=1 Y=2",
		"echo $X $Y",
		"env | grep -c '^X='",
		"echo '$HOME'",
		"echo \"$HOME\"",
		"echo ${HOME}/demo",
		"A=1; bash -c 'echo \"[$A]\"'",
		"A=2 bash -c 'echo \"[$A]\"'",
		"echo \"[$A]\""
	]
}
