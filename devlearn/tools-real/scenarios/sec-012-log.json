{
	"id": "sec-012-log",
	"tool": "shell",
	"lesson": "sec-012",
	"note": "アクセスのログを grep で絞り、cut・sort・uniq -c で数える",
	"steps": [
		"printf '%s\\n' '192.0.2.10 - - [10/Nov/2026:09:00:01 +0900] \"GET /index.html HTTP/1.1\" 200 512' '198.51.100.7 - - [10/Nov/2026:09:00:03 +0900] \"POST /login HTTP/1.1\" 401 128' '198.51.100.7 - - [10/Nov/2026:09:00:04 +0900] \"POST /login HTTP/1.1\" 401 128' '192.0.2.10 - - [10/Nov/2026:09:00:09 +0900] \"GET /style.css HTTP/1.1\" 200 2048' '198.51.100.7 - - [10/Nov/2026:09:00:05 +0900] \"POST /login HTTP/1.1\" 401 128' '203.0.113.5 - - [10/Nov/2026:09:00:20 +0900] \"POST /login HTTP/1.1\" 401 128' '198.51.100.7 - - [10/Nov/2026:09:00:06 +0900] \"POST /login HTTP/1.1\" 200 256' '203.0.113.5 - - [10/Nov/2026:09:01:02 +0900] \"GET /admin HTTP/1.1\" 403 64' '192.0.2.11 - - [10/Nov/2026:09:01:30 +0900] \"GET /index.html HTTP/1.1\" 200 512' '203.0.113.5 - - [10/Nov/2026:09:02:00 +0900] \"GET /../../etc/passwd HTTP/1.1\" 400 0' > access.log",
		"cat access.log",
		"wc -l access.log",
		"grep ' 401 ' access.log",
		"grep -c ' 401 ' access.log",
		"grep ' 401 ' access.log | cut -d ' ' -f 1",
		"grep ' 401 ' access.log | cut -d ' ' -f 1 | sort",
		"grep ' 401 ' access.log | cut -d ' ' -f 1 | sort | uniq -c",
		"grep ' 401 ' access.log | cut -d ' ' -f 1 | sort | uniq -c | sort -rn",
		"grep ' 401 ' access.log | cut -d ' ' -f 1 | sort | uniq -c | sort -rn | head -n 1",
		"grep ' 401 ' access.log | cut -d ' ' -f 1 | uniq -c",
		"cut -d ' ' -f 9 access.log | sort | uniq -c",
		"cut -d ' ' -f 7 access.log | sort | uniq -c | sort -rn",
		"cut -d ' ' -f 1,9 access.log",
		"cut -d ' ' -f 6-7 access.log | head -n 3",
		"cut -f 1 access.log | head -n 2",
		"cut -d ' ' access.log",
		"cut -d ' ' -f 0 access.log",
		"cut -d '\"' -f 2 access.log | sort | uniq -c | sort -rn",
		"grep -c 'POST /login' access.log",
		"grep '\\.\\./' access.log",
		"grep -E ' (403|400) ' access.log | cut -d ' ' -f 1,7,9",
		"grep 'POST /login' access.log | grep -v ' 401 '",
		"cut -d ' ' -f 1 access.log | sort | uniq -c | sort -rn | head -n 2",
		"grep ' 401 ' nothere.log | cut -d ' ' -f 1",
		"cut -d ' ' -f 1 nothere.log",
		"sort access.log | head -n 1",
		"cut -c 1-12 access.log | head -n 2",
		"cut -d ' ' -f 9 access.log | sort -n | uniq -c"
	]
}
