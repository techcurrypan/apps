{
	"id": "sec-013-secrets",
	"tool": "git",
	"lesson": "sec-013",
	"note": "鍵やトークンを、リポジトリと履歴に入れない",
	"steps": [
		"git init",
		"printf 'print(1)\\n' > app.py",
		"printf 'TOKEN=example-not-a-real-token\\n' > .env",
		"git add .",
		"git status --short",
		"git commit -m \"first\"",
		"git log --stat --oneline",
		"git rm --cached .env",
		"git status --short",
		"printf '.env\\n' > .gitignore",
		"git add .gitignore",
		"git status --short",
		"git commit -m \"stop tracking .env\"",
		"git status --short",
		"ls -a",
		"git log --oneline",
		"git log -p --oneline -- .env",
		"git show HEAD~1:.env"
	]
}
