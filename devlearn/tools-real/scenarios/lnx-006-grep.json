{
	"id": "lnx-006-grep",
	"tool": "shell",
	"lesson": "lnx-006",
	"note": "grep の -n -i -v -c -E と ^ $、見つからないとき・無いファイル・誤った式",
	"steps": [
		"printf '%s\\n' '2026-11-10 09:00:01 INFO start' '2026-11-10 09:00:05 WARN slow response' '2026-11-10 09:01:00 ERROR db timeout' '2026-11-10 09:01:30 info retry' '2026-11-10 09:02:00 ERROR disk full' '2026-11-10 09:03:00 INFO done' > app.log",
		"cat app.log",
		"grep ERROR app.log",
		"grep -n ERROR app.log",
		"grep info app.log",
		"grep -i info app.log",
		"grep -v INFO app.log",
		"grep -c ERROR app.log",
		"grep -E 'ERROR|WARN' app.log",
		"grep 'ERROR|WARN' app.log",
		"grep 'ERROR\\|WARN' app.log",
		"grep '^2026' app.log",
		"grep 'done$' app.log",
		"grep -E '(timeout|full)$' app.log",
		"grep nothing app.log",
		"grep nothing app.log; echo $?",
		"grep ERROR nothere",
		"grep ERROR nothere; echo $?",
		"printf 'ERROR x\\n' > other.log",
		"grep -c ERROR app.log other.log",
		"grep ERROR app.log other.log",
		"cat app.log | grep -i error",
		"grep -in error app.log",
		"grep -vc INFO app.log",
		"grep",
		"grep -E '[' app.log",
		"grep '[' app.log",
		"grep -E 'ERROR (db|disk)' app.log",
		"grep -n -i -v info app.log",
		"grep -E '^.{20}INFO' app.log",
		"grep 'INFO.*done' app.log",
		"grep -c '' app.log",
		"grep -E 'a+' other.log",
		"grep -E '[0-9]{2}:0[12]' app.log",
		"grep warn app.log",
		"grep -i WARN app.log | wc -l",
		"grep ' INFO ' app.log",
		"grep -e ERROR -e WARN app.log",
		"mkdir dir",
		"grep x dir"
	]
}
