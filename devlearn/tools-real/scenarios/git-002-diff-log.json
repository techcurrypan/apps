{
	"id": "git-002-diff-log",
	"tool": "git",
	"lesson": "git-002",
	"note": "何が変わったかを status・diff・log で確かめる",
	"steps": [
		"git init",
		"printf 'apple\\nbanana\\ncherry\\n' > fruits.txt",
		"git add fruits.txt",
		"git commit -m \"add fruits\"",
		"printf 'apple\\nblueberry\\ncherry\\ndate\\n' > fruits.txt",
		"git status",
		"git status --short",
		"git diff",
		"git diff --staged",
		"git add fruits.txt",
		"git diff",
		"git diff --staged",
		"git status --short",
		"git commit -m \"change fruits\"",
		"git log",
		"git log --oneline",
		"printf 'memo\\n' > memo.txt",
		"git diff",
		"git status --short",
		"rm fruits.txt",
		"git status",
		"git status --short",
		"git diff",
		"git log -n 1 --oneline",
		"git diff HEAD~1 HEAD",
		"git log --oneline nope"
	]
}
