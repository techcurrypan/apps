		"wc -l log.txt",
		"wc log.txt",
		"head log.txt",
		"head -n 3 log.txt",
		"head -3 log.txt",
		"tail log.txt",
		"tail -n 2 log.txt",
		"tail -2 log.txt",
		"wc -l < log.txt",
		"cat log.txt | wc -l",
		"head -n 3 nothere",
		"tail nothere",
		"wc nothere",
		"cat nothere",
		"printf 'a\\nb' > nonl.txt",
		"wc -l nonl.txt",
		"cat nonl.txt",
		"head -n 2 log.txt nonl.txt",
		"tail -n 1 log.txt nonl.txt",
		"wc -l log.txt nonl.txt",
		"wc -c log.txt",
		"wc -w log.txt",
		"head -n abc log.txt",
		"tail -n abc log.txt",
		"mkdir d",
		"cat d",
		"head d",
		"wc -l d",
		"cat log.txt | head -n 5 | tail -n 2",
		"head -n 0 log.txt",
		"tail -n 0 log.txt",
		"head -n 20 log.txt | wc -l",
		"tail -n +11 log.txt",
		"wc -l log.txt nonl.txt nothere"
	]
