{
	"id": "ctr-005-volume",
	"tool": "docker",
	"lesson": "ctr-005",
	"world": "docker",
	"note": "コンテナの中に書いた物は消すと失う。ボリュームにつなぐと残る",
	"steps": [
		"docker run --name a busybox:1.37 sh -c 'echo 120 > /data.txt'",
		"docker rm a",
		"docker run --rm busybox:1.37 cat /data.txt",
		"docker volume create shopdata",
		"docker volume ls",
		"docker run --rm -v shopdata:/data busybox:1.37 sh -c 'echo 120 > /data/sales.txt'",
		"docker run --rm -v shopdata:/data busybox:1.37 cat /data/sales.txt",
		"docker volume rm shopdata",
		"docker volume ls"
	]
}
