{
	"id": "lnx-005-pipe",
	"tool": "shell",
	"lesson": "lnx-005",
	"note": "> と >> とパイプ、sort と uniq、2> と 2>&1",
	"steps": [
		"printf 'b\\na\\nc\\na\\nb\\na\\n' > words.txt",
		"echo hello > out.txt",
		"cat out.txt",
		"echo world >> out.txt",
		"cat out.txt",
		"echo again > out.txt",
		"cat out.txt",
		"sort words.txt",
		"sort words.txt | uniq",
		"sort words.txt | uniq -c",
		"sort words.txt | uniq -c | sort -rn",
		"uniq words.txt",
		"uniq -c words.txt",
		"cat words.txt | wc -l",
		"sort words.txt > sorted.txt",
		"cat sorted.txt",
		"ls nothere > list.txt",
		"cat list.txt",
		"ls nothere 2> err.txt",
		"cat err.txt",
		"ls nothere > all.txt 2>&1",
		"cat all.txt",
		"sort -r words.txt",
		"sort nothere",
		"echo hi |",
		"| sort",
		"echo a | sort | uniq -c",
		"sort words.txt | head -n 2",
		"wc -l words.txt sorted.txt",
		"sort words.txt > words.txt",
		"cat words.txt",
		"printf '10\\n9\\n100\\n' > nums.txt",
		"sort nums.txt",
		"sort -n nums.txt",
		"sort -rn nums.txt",
		"sort -u sorted.txt",
		"echo x 2> e.txt",
		"cat e.txt",
		"ls words.txt nothere 2>&1 | wc -l",
		"echo one > a.txt > b.txt",
		"cat a.txt",
		"cat b.txt",
		"cat < sorted.txt | uniq -c"
	]
}
