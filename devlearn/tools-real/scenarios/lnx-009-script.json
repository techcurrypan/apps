{
	"id": "lnx-009-script",
	"tool": "shell",
	"lesson": "lnx-009",
	"note": "引数・$#・$?・exit・if と [ ]。よくある書き間違い",
	"steps": [
		"printf '%s\\n' '#!/bin/bash' 'echo \"args: $#\"' 'echo \"first: $1\"' 'echo \"second: $2\"' > args.sh",
		"cat args.sh",
		"bash args.sh",
		"bash args.sh one two",
		"bash args.sh 'one two'",
		"printf '%s\\n' '#!/bin/bash' 'if [ $# -eq 0 ]; then' '  echo \"usage: greet.sh NAME\" >&2' '  exit 2' 'fi' 'echo \"hello, $1\"' > greet.sh",
		"bash greet.sh",
		"echo $?",
		"bash greet.sh taro",
		"echo $?",
		"./greet.sh taro",
		"echo $?",
		"chmod +x greet.sh",
		"./greet.sh hanako",
		"./greet.sh 2> /dev/null; echo $?",
		"printf '%s\\n' '#!/bin/bash' 'if [ -f \"$1\" ]; then' '  echo \"$1 exists\"' 'else' '  echo \"$1 not found\"' '  exit 1' 'fi' > check.sh",
		"bash check.sh greet.sh",
		"bash check.sh nope",
		"echo $?",
		"bash check.sh greet.sh && echo ok",
		"bash check.sh nope || echo failed",
		"bash nothere.sh",
		"echo $?",
		"printf '%s\\n' 'if [ 1 -eq 1 ]' 'echo x' 'fi' > bad.sh",
		"bash bad.sh",
		"echo $?",
		"[ abc -eq 1 ]; echo $?",
		"[1 -eq 1]",
		"[ 1 -eq 1]",
		"[ 2 -gt 1 ] && echo yes",
		"[ -d /tmp ] && echo dir",
		"[ -z \"\" ] && echo empty",
		"[ \"a\" = \"a\" ] && echo same",
		"[ \"a\" != \"b\" ] && echo diff",
		"[ 3 -le 2 ]; echo $?",
		"true; echo $?",
		"false; echo $?",
		"printf '%s\\n' '#!/bin/bash' 'echo start' 'exit 3' 'echo never' > ex.sh",
		"bash ex.sh",
		"echo $?",
		"printf '%s\\n' '#!/bin/bash' 'if [ \"$1\" = \"\" ]; then' '  echo \"no name\"' 'elif [ \"$1\" = \"admin\" ]; then' '  echo \"hello, boss\"' 'else' '  echo \"hello, $1\"' 'fi' > el.sh",
		"bash el.sh",
		"bash el.sh admin",
		"bash el.sh sato",
		"printf '%s\\n' 'echo \"$0\"' > zero.sh",
		"bash zero.sh",
		"printf '%s\\n' 'if [ -f x ]; then' 'echo x' > nofi.sh",
		"bash nofi.sh"
	]
}
