{
	"id": "lnx-011-sudo",
	"tool": "shell",
	"lesson": "lnx-011",
	"world": "shop",
	"note": "利用者・組・sudo。root の物を読む・書く、sudo と > のよくある間違い",
	"steps": [
		"whoami",
		"id",
		"groups",
		"id root",
		"groups root",
		"id nosuch",
		"ls -l /srv/shop",
		"ls -ld /srv/shop",
		"cat /srv/shop/report.txt",
		"sudo cat /srv/shop/report.txt",
		"sudo whoami",
		"sudo id",
		"whoami",
		"echo 'sales: 130' > /srv/shop/report.txt",
		"sudo echo 'sales: 130' > /srv/shop/report.txt",
		"echo 'sales: 130' | sudo tee /srv/shop/report.txt",
		"sudo cat /srv/shop/report.txt",
		"ls -l /srv/shop/report.txt",
		"touch /srv/shop/new.txt",
		"sudo touch /srv/shop/new.txt",
		"ls -l /srv/shop",
		"rm -f /srv/shop/new.txt",
		"sudo rm /srv/shop/new.txt",
		"ls /srv/shop",
		"mkdir /srv/shop/logs",
		"sudo mkdir /srv/shop/logs",
		"ls -ld /srv/shop/logs",
		"sudo nosuchcmd",
		"sudo cd /srv",
		"sudo -u learner whoami",
		"sudo -u nobody id",
		"echo hello > ~/note.txt",
		"ls -l ~/note.txt",
		"sudo cp /srv/shop/report.txt ~/copy.txt",
		"ls -l ~/copy.txt",
		"cat ~/copy.txt",
		"cp ~/note.txt /srv/shop/",
		"sudo cp ~/note.txt /srv/shop/",
		"ls -l /srv/shop",
		"whoami"
	]
}
